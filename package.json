{
  "name": "local-commander-mcp-agent",
  "version": "0.1.0",
  "description": "Self-hosted MCP server for controlled local development access: files, Git, allowlisted commands, processes and localhost. stdio or HTTP.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/netbka/local-commander-mcp-agent.git"
  },
  "homepage": "https://github.com/netbka/local-commander-mcp-agent#readme",
  "bugs": "https://github.com/netbka/local-commander-mcp-agent/issues",
  "keywords": ["mcp", "model-context-protocol", "mcp-server", "claude", "cursor", "chatgpt", "developer-tools"],
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "local-commander-mcp-agent": "dist/index.js"
  },
  "files": [
    "dist/",
    "packages/",
    "release/personal/OwnerBridge.exe",
    "local-commander.config.example.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "predev": "node scripts/build-owner-bridge.mjs --personal && node scripts/free-port.mjs",
    "dev": "tsx src/index.ts",
    "prebuild": "node scripts/build-owner-bridge.mjs --personal",
    "build": "tsc -p tsconfig.json",
    "prestart": "node scripts/free-port.mjs",
    "start": "node dist/index.js",
    "stdio": "node dist/index.js --stdio",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "node scripts/build-owner-bridge.mjs --personal",
    "test": "node --import tsx --test test/**/*.test.ts",
    "prepack": "npm run build",
    "prepublishOnly": "node -e \"if (!require('fs').statSync('release/personal/OwnerBridge.exe').size) process.exit(1)\""
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "dotenv": "^18.0.4",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0"
  }
}
